server/nas-client/bin/arm64/* binary
server/nas-client/bin/SHA256SUMS text eol=lf
server/nas-client/**/*.go text eol=lf
server/nas-client/**/*.env text eol=lf
server/nas-client/helper/go.* text eol=lf
