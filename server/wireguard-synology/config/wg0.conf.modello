# Modello del server. Lo script scripts/prima-generazione.sh crea config/wg0.conf
# sostituendo __CHIAVE_PRIVATA__ con la chiave generata. Non copiare la chiave a mano.
[Interface]
Address = 10.66.0.1/24
ListenPort = 51820
PrivateKey = __CHIAVE_PRIVATA__
# Inoltro tra i PC della VPN e verso la LAN 192.168.1.0/24 (NAT in uscita su eth0).
# Se non serve raggiungere PC della LAN senza client, togli le due righe PostUp/PostDown.
PostUp = iptables -A FORWARD -i %i -j ACCEPT; iptables -A FORWARD -o %i -j ACCEPT; iptables -t nat -A POSTROUTING -s 10.66.0.0/24 -d 192.168.1.0/24 -o eth0 -j MASQUERADE
PostDown = iptables -D FORWARD -i %i -j ACCEPT; iptables -D FORWARD -o %i -j ACCEPT; iptables -t nat -D POSTROUTING -s 10.66.0.0/24 -d 192.168.1.0/24 -o eth0 -j MASQUERADE

# I [Peer] sono aggiunti da scripts/aggiungi-pc.sh (ogni blocco inizia con "# PC: nome").
