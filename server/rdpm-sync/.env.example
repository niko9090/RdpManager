# Copia questo file in ".env" (nella stessa cartella del docker-compose.yml) e compila.
# Chiave per creare gli account via HTTP: almeno 16 caratteri casuali. Lasciala vuota per usare solo il comando crea-account.
RDPM_SYNC_ADMIN_KEY=
# Porta del server (deve coincidere con quella pubblicata dal contenitore wireguard).
RDPM_SYNC_PORT=8787
# Durata del login (giorni) e dimensione massima del documento (MB).
RDPM_SYNC_TOKEN_DAYS=30
RDPM_SYNC_MAX_DOC_MB=8
# Registrazione dall'app senza chiave di amministrazione: 1 = aperta a chiunque raggiunga il server;
# in alternativa un codice (consigliato: lo digiti una volta nell'app) che resta obbligatorio.
RDPM_SYNC_OPEN_REGISTRATION=
RDPM_SYNC_REGISTRATION_CODE=
# VPN automatica: endpoint e DNS scritti nei profili dei PC (DNS vuoto = nessuno).
RDPM_VPN_ENDPOINT=syncnetpro.com:51820
RDPM_VPN_DNS=
