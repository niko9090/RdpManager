# Copia questo file in ".env" (nella stessa cartella del docker-compose.yml) e compila.
# Chiave per creare gli account via HTTP: almeno 16 caratteri casuali. Lasciala vuota per usare solo il comando crea-account.
RDPM_SYNC_ADMIN_KEY=
# Porta del server (deve coincidere con quella pubblicata dal contenitore wireguard).
RDPM_SYNC_PORT=8787
# Durata del login (giorni) e dimensione massima del documento (MB).
RDPM_SYNC_TOKEN_DAYS=30
RDPM_SYNC_MAX_DOC_MB=8
