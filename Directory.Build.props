<Project>
  <!--
    Niente Source Link e niente interrogazioni a git durante la compilazione.
    Perché: con Source Link l'SDK scrive obj/Release/net8.0-windows/RdpManager.sourcelink.json con l'hash del
    commit e lo passa al compilatore, quindi dopo ogni commit la dll risulta da ricompilare. Quando build e test
    vengono lanciati insieme (come nelle misure dei criteri) ricompilano la stessa RdpManager.dll in parallelo e
    uno dei due fallisce con CS2012 (file in uso da un altro processo). Senza Source Link la build dipende solo dal
    codice: un commit che cambia solo documentazione non fa ricompilare nulla.
  -->
  <PropertyGroup>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <!--
    Restore separato per le compilazioni con un RID esplicito (-r linux-x64).
    Perché: "dotnet build ... -r linux-x64" e "dotnet test" lanciati insieme nella stessa cartella rifanno il restore
    dello stesso progetto e scrivono lo stesso obj/project.assets.json e obj/*.nuget.*; uno dei due può fallire con
    NuGet.targets: "Impossibile creare un file, se il file esiste già". Con un RID il restore ha comunque un altro
    grafo di pacchetti (runtime pack), quindi gli diamo una cartella sua: obj/rid-<RID>/. Va impostato qui, prima
    dell'import dell'SDK. Senza RID non cambia nulla (obj/ come sempre).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\rid-$(RuntimeIdentifier)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <!-- L'SDK esclude dai file .cs solo BaseIntermediateOutputPath: senza questo entrerebbero i .cs generati in obj\Debug. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
