<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RdpManager.Linux.ViewModels"
        x:Class="RdpManager.Linux.Dialogs.ConnectionEditWindow"
        xmlns:d="using:RdpManager.Linux.Dialogs"
        x:DataType="vm:ConnectionEditViewModel"
        Title="{Binding WindowTitle}" Width="560" Height="680" MinWidth="380" MinHeight="420" CanResize="True"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Spacing="8">
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="Annulla" Click="OnCancel" IsCancel="True" MinWidth="96" />
          <Button Content="Salva" Click="OnSave" IsDefault="True" Classes="accent" MinWidth="96" />
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Spacing="10" Margin="20,10,20,20">
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Nome" />
          <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="Nome mostrato nell'elenco" />
        </Grid>
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Computer" />
          <TextBox Grid.Column="1" Text="{Binding Host}" Watermark="nome-pc, indirizzo IP o nome:porta" />
        </Grid>
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Porta" />
          <TextBox Grid.Column="1" Text="{Binding Port}" Width="120" HorizontalAlignment="Left" />
        </Grid>
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Cartella" />
          <AutoCompleteBox Grid.Column="1" Text="{Binding Group}" ItemsSource="{Binding Groups}" Watermark="Vuota = nessuna cartella (usa / per le sottocartelle)" />
        </Grid>
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Etichetta" />
          <TextBox Grid.Column="1" Text="{Binding Label}" Watermark="Per esempio PROD" MaxLength="12" />
        </Grid>
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Colore dell'etichetta" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding Color}" Watermark="#RRGGBB (vuoto = nessuno)" Width="200" />
            <Border Width="28" Height="28" CornerRadius="4" BorderThickness="1" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    Background="{Binding ColorPreview, Converter={x:Static d:HexBrushConverter.Instance}}" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="170,*"><CheckBox Grid.Column="1" Content="Preferita" IsChecked="{Binding IsFavorite}" /></Grid>
        <TextBlock Classes="section" Text="Credenziali" />
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Profilo" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Utente" />
          <TextBox Grid.Column="1" Text="{Binding Username}" IsEnabled="{Binding OwnCredentials}" />
        </Grid>
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Dominio" />
          <TextBox Grid.Column="1" Text="{Binding Domain}" IsEnabled="{Binding OwnCredentials}" />
        </Grid>
        <Grid ColumnDefinitions="170,*,Auto">
          <TextBlock Classes="label" Text="Password" />
          <TextBox Grid.Column="1" Text="{Binding Password}" PasswordChar="●" RevealPassword="{Binding ShowPassword}"
                   Watermark="{Binding PasswordHint}" IsEnabled="{Binding OwnCredentials}" />
          <CheckBox Grid.Column="2" Content="Mostra" IsChecked="{Binding ShowPassword}" IsEnabled="{Binding OwnCredentials}" Margin="8,0,0,0" />
        </Grid>
        <Grid ColumnDefinitions="170,*" IsVisible="{Binding PasswordWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Grid.Column="1" Classes="error" Text="{Binding PasswordWarning}" />
        </Grid>
        <TextBlock Classes="section" Text="Schermo e dispositivi" />
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Risoluzione" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding Resolution}" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="170,*" IsVisible="{Binding FixedResolution}">
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding DesktopWidth}" Width="110" Watermark="Larghezza" />
            <TextBlock Text="×" VerticalAlignment="Center" />
            <TextBox Text="{Binding DesktopHeight}" Width="110" Watermark="Altezza" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="170,*"><CheckBox Grid.Column="1" Content="Usa la risoluzione della cartella" IsChecked="{Binding InheritFolderResolution}"
                                                  ToolTip.Tip="Se la cartella ha una risoluzione impostata («Impostazioni della cartella…»), vale quella al posto di questa." /></Grid>
        <Grid ColumnDefinitions="170,*"><CheckBox Grid.Column="1" Content="Usa tutti i monitor" IsChecked="{Binding UseAllMonitors}"
                                                  ToolTip.Tip="A schermo intero la sessione occupa tutti i monitor come un unico desktop." /></Grid>
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Audio" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding AudioChoices}" SelectedItem="{Binding Audio}" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Qualità" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding QualityChoices}" SelectedItem="{Binding Quality}" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="170,*"><CheckBox Grid.Column="1" Content="Condividi gli appunti" IsChecked="{Binding RedirectClipboard}" /></Grid>
        <Grid ColumnDefinitions="170,*"><CheckBox Grid.Column="1" Content="Condividi le unità" IsChecked="{Binding RedirectDrives}" /></Grid>
        <Grid ColumnDefinitions="170,*"><CheckBox Grid.Column="1" Content="Condividi le stampanti" IsChecked="{Binding RedirectPrinters}" /></Grid>
        <Grid ColumnDefinitions="170,*"><CheckBox Grid.Column="1" Content="Condividi il microfono" IsChecked="{Binding RedirectMicrophone}" /></Grid>
        <TextBlock Classes="section" Text="Rete" />
        <Grid ColumnDefinitions="170,*"><CheckBox Grid.Column="1" Content="Riconnetti automaticamente" IsChecked="{Binding AutoReconnect}" /></Grid>
        <Grid ColumnDefinitions="170,*" IsVisible="{Binding AutoReconnect}">
          <TextBlock Classes="label" Text="Tentativi al massimo" />
          <TextBox Grid.Column="1" Text="{Binding AutoReconnectMaxAttempts}" Width="80" HorizontalAlignment="Left" />
        </Grid>
        <Grid ColumnDefinitions="170,*"><CheckBox Grid.Column="1" Content="Tieni sveglia la sessione" IsChecked="{Binding KeepAlive}" /></Grid>
        <Grid ColumnDefinitions="170,*"><CheckBox Grid.Column="1" Content="Passa da un Remote Desktop Gateway" IsChecked="{Binding UseGateway}" /></Grid>
        <Grid ColumnDefinitions="170,*" IsVisible="{Binding UseGateway}">
          <TextBlock Classes="label" Text="Gateway" />
          <TextBox Grid.Column="1" Text="{Binding GatewayHost}" Watermark="Host del gateway (anche host:porta)" />
        </Grid>
        <Grid ColumnDefinitions="170,*" IsVisible="{Binding UseGateway}">
          <TextBlock Classes="label" Text="Credenziali del gateway" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding GatewayProfiles}" SelectedItem="{Binding GatewayProfile}" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid ColumnDefinitions="170,*">
          <TextBlock Classes="label" Text="Indirizzo MAC" />
          <TextBox Grid.Column="1" Text="{Binding MacAddress}" Watermark="AA:BB:CC:DD:EE:FF (per accendere il computer)" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
