<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RdpManager.Linux.ViewModels"
        x:Class="RdpManager.Linux.Dialogs.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Impostazioni" Width="480" Height="440"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Annulla" Click="OnCancel" IsCancel="True" />
      <Button Content="Salva" Click="OnSave" IsDefault="True" Classes="accent" />
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock Text="Tema" /><ComboBox ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch" />
      <TextBlock Text="Ordine delle connessioni" /><ComboBox ItemsSource="{Binding OrderChoices}" SelectedItem="{Binding Order}" HorizontalAlignment="Stretch" />
      <TextBlock Text="Aggiornamenti" /><ComboBox ItemsSource="{Binding UpdateChoices}" SelectedItem="{Binding Update}" HorizontalAlignment="Stretch" />
      <CheckBox Content="Ricorda le ultime connessioni aperte" IsChecked="{Binding HistoryEnabled}" />
      <CheckBox Content="Registro dettagliato (per cercare i guasti)" IsChecked="{Binding VerboseLog}" />
      <Separator />
      <TextBlock Text="File dei dati (lo stesso dell'app Windows, per la sincronizzazione)" TextWrapping="Wrap" />
      <TextBox Text="{Binding DataFilePath}" IsReadOnly="True" />
    </StackPanel>
  </DockPanel>
</Window>
