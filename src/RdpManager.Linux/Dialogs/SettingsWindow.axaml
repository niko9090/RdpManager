<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RdpManager.Linux.ViewModels"
        xmlns:vms="using:RdpManager.Linux.ViewModels.Settings"
        xmlns:pages="using:RdpManager.Linux.Dialogs.Settings"
        x:Class="RdpManager.Linux.Dialogs.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Impostazioni" Width="720" Height="520" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Annulla" Click="OnCancel" IsCancel="True" MinWidth="96" />
        <Button Content="Salva" Click="OnSave" IsDefault="True" Classes="accent" MinWidth="96" />
      </StackPanel>
    </Border>

    <!-- Navigazione a sinistra: una voce per pagina -->
    <Border DockPanel.Dock="Left" Width="190" Background="{DynamicResource AppSidebarBrush}">
      <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" Margin="6">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vms:SettingsPageViewModel">
            <TextBlock Text="{Binding Title}" Margin="6,4" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <ScrollViewer>
      <ContentControl Content="{Binding SelectedPage}" Margin="20">
        <ContentControl.DataTemplates>
          <pages:SettingsPageTemplate />
        </ContentControl.DataTemplates>
      </ContentControl>
    </ScrollViewer>
  </DockPanel>
</Window>
