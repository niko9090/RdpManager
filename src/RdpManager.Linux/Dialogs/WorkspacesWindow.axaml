<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:f="using:RdpManager.Linux.Features"
        x:Class="RdpManager.Linux.Dialogs.WorkspacesWindow"
        x:DataType="f:WorkspacesViewModel"
        Title="Spazi di lavoro" Width="560" Height="480" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <Button DockPanel.Dock="Bottom" Content="Chiudi" Click="OnClose" IsCancel="True" HorizontalAlignment="Right" MinWidth="96" Margin="0,12,0,0" />

    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
      <TextBlock Classes="label" Text="Scorciatoia per riaprire lo spazio (per esempio Ctrl+Alt+Maiusc+1; vuota = nessuna)" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Text="{Binding Shortcut}" />
        <Button Grid.Column="1" Content="Imposta" Command="{Binding ApplyShortcutCommand}" Margin="6,0,0,0" />
      </Grid>
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" />
      <WrapPanel>
        <Button Classes="accent" Content="Apri" Command="{Binding OpenCommand}" Margin="0,0,6,0" />
        <Button Classes="danger" Content="Elimina" Command="{Binding DeleteCommand}" />
      </WrapPanel>
    </StackPanel>

    <Grid>
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="f:WorkspaceItem">
            <StackPanel Margin="4">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Classes="muted"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" TextAlignment="Center" />
    </Grid>
  </DockPanel>
</Window>
