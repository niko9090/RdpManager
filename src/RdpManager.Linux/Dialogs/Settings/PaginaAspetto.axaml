<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpManager.Linux.ViewModels.Settings"
             x:Class="RdpManager.Linux.Dialogs.Settings.PaginaAspetto"
             x:DataType="vm:AspettoPageViewModel">
  <!-- Pagina Impostazioni «Aspetto» (blocco A). -->
  <StackPanel Spacing="10">
    <TextBlock Classes="section" Margin="0,0,0,4" Text="Aspetto" />
    <Grid ColumnDefinitions="170,*"><TextBlock Classes="label" Text="Tema" /><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" HorizontalAlignment="Stretch" /></Grid>
  </StackPanel>
</UserControl>
