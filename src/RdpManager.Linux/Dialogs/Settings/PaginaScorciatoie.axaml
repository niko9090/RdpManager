<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpManager.Linux.ViewModels.Settings"
             x:Class="RdpManager.Linux.Dialogs.Settings.PaginaScorciatoie"
             x:DataType="vm:ScorciatoiePageViewModel">
  <!-- Pagina «Scorciatoie» (come Windows): combinazioni di tasti e pulsante «Predefinite». -->
  <StackPanel Classes="group">
    <TextBlock Classes="groupTitle" Text="Combinazioni di tasti" />
    <StackPanel Classes="groupBody">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ShortcutEntry">
            <Grid ColumnDefinitions="260,170" Margin="0,3">
              <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding Description}" />
              <TextBox Grid.Column="1" Text="{Binding Text}" Watermark="(nessuna)" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="note" Text="{Binding Note}" />
      <TextBlock Classes="error" Text="{Binding Problems}" />
      <Button Content="Predefinite" Command="{Binding ResetCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </StackPanel>
</UserControl>
