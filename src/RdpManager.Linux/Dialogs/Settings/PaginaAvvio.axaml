<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpManager.Linux.ViewModels.Settings"
             x:Class="RdpManager.Linux.Dialogs.Settings.PaginaAvvio"
             x:DataType="vm:AvvioPageViewModel">
  <!-- Pagina Impostazioni «Avvio» (blocco A). -->
  <StackPanel Spacing="10">
    <TextBlock Classes="section" Margin="0,0,0,4" Text="Avvio" />
    <CheckBox Content="Registra la cronologia delle connessioni" IsChecked="{Binding HistoryEnabled}" />
    <CheckBox Content="Registro dettagliato (per cercare i guasti)" IsChecked="{Binding VerboseLog}" />
    <TextBlock Classes="section" Text="Dati" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="File dei dati (lo stesso dell'app Windows, per la sincronizzazione)" />
    <TextBox Text="{Binding DataFilePath}" IsReadOnly="True" />
  </StackPanel>
</UserControl>
