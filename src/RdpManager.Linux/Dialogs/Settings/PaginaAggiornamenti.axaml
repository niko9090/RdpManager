<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpManager.Linux.ViewModels.Settings"
             x:Class="RdpManager.Linux.Dialogs.Settings.PaginaAggiornamenti"
             x:DataType="vm:AggiornamentiPageViewModel">
  <!-- Pagina «Aggiornamenti» (solo aspetto: la logica di aggiornamento non cambia). Le tre scelte sono a pallino come su Windows. -->
  <StackPanel Classes="group">
    <TextBlock Classes="groupTitle" Text="Controllo degli aggiornamenti" />
    <StackPanel Classes="groupBody">
      <RadioButton GroupName="aggiornamenti" Content="Automatici con conferma: controlla in sottofondo, poi avvisa" IsChecked="{Binding AutoMode}" />
      <RadioButton GroupName="aggiornamenti" Content="Solo avviso nella barra di stato" IsChecked="{Binding NotifyMode}" />
      <RadioButton GroupName="aggiornamenti" Content="Spenti (resta «Aiuto › Controlla aggiornamenti»)" IsChecked="{Binding OffMode}" />
      <TextBlock Classes="note" Text="{Binding Note}" />
      <TextBlock Text="{Binding Version}" />
    </StackPanel>
  </StackPanel>
</UserControl>
