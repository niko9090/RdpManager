<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpManager.Linux.ViewModels.Settings"
             x:Class="RdpManager.Linux.Dialogs.Settings.PaginaAggiornamenti"
             x:DataType="vm:AggiornamentiPageViewModel">
  <!-- Pagina Impostazioni «Aggiornamenti» (blocco B). -->
  <StackPanel Spacing="10">
    <TextBlock Classes="section" Margin="0,0,0,4" Text="Aggiornamenti" />
    <Grid ColumnDefinitions="170,*"><TextBlock Classes="label" Text="Aggiornamenti" /><ComboBox Grid.Column="1" ItemsSource="{Binding UpdateChoices}" SelectedItem="{Binding Update}" HorizontalAlignment="Stretch" /></Grid>
    <TextBlock Text="{Binding Version}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Note}" />
  </StackPanel>
</UserControl>
