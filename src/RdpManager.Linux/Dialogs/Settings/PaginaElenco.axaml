<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpManager.Linux.ViewModels.Settings"
             x:Class="RdpManager.Linux.Dialogs.Settings.PaginaElenco"
             x:DataType="vm:ElencoPageViewModel">
  <!-- Pagina Impostazioni «Elenco» (blocco A). -->
  <StackPanel Spacing="10">
    <TextBlock Classes="section" Margin="0,0,0,4" Text="Elenco" />
    <Grid ColumnDefinitions="170,*"><TextBlock Classes="label" Text="Ordine delle connessioni" /><ComboBox Grid.Column="1" ItemsSource="{Binding OrderChoices}" SelectedItem="{Binding Order}" HorizontalAlignment="Stretch" /></Grid>
  </StackPanel>
</UserControl>
