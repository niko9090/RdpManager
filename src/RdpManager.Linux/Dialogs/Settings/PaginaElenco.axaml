<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpManager.Linux.ViewModels.Settings"
             x:Class="RdpManager.Linux.Dialogs.Settings.PaginaElenco"
             x:DataType="vm:ElencoPageViewModel">
  <!-- Pagina Impostazioni «Elenco» (blocco A). -->
  <StackPanel Spacing="10">
    <TextBlock Classes="section" Margin="0,0,0,4" Text="Elenco delle connessioni" />
    <CheckBox Content="Ordine delle connessioni scelto trascinandole (altrimenti per nome)" IsChecked="{Binding ManualOrder}" />
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Note}" />
  </StackPanel>
</UserControl>
