<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RdpManager.Linux.ViewModels.Settings"
             x:Class="RdpManager.Linux.Dialogs.Settings.PaginaPin"
             x:DataType="vm:PinPageViewModel">
  <!-- Pagina «Sicurezza» (come Windows): blocco con PIN. -->
  <StackPanel Classes="group">
    <TextBlock Classes="groupTitle" Text="Blocco con PIN" />
    <StackPanel Classes="groupBody">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8">
        <TextBlock Text="{Binding PinState}" VerticalAlignment="Center" />
        <Button Content="Imposta PIN…" Command="{Binding SetPinCommand}" />
        <Button Content="Togli PIN" Command="{Binding RemovePinCommand}" />
      </WrapPanel>
      <WrapPanel Orientation="Horizontal" ItemSpacing="6">
        <TextBlock Text="Blocca dopo" VerticalAlignment="Center" />
        <TextBox Text="{Binding LockAfterMinutes}" Width="90" />
        <TextBlock Text="minuti di inattività (0 = solo a mano)" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <TextBlock Classes="note" Text="{Binding Note}" />
    </StackPanel>
  </StackPanel>
</UserControl>
