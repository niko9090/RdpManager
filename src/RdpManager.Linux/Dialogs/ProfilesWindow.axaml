<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RdpManager.Linux.ViewModels"
        xmlns:core="using:RdpManager.Core"
        x:Class="RdpManager.Linux.Dialogs.ProfilesWindow"
        x:DataType="vm:ProfilesViewModel"
        Title="Profili di credenziali" Width="640" Height="420"
        WindowStartupLocation="CenterOwner">

  <Grid ColumnDefinitions="220,*" Margin="12">
    <DockPanel Margin="0,0,12,0">
      <Button DockPanel.Dock="Bottom" Content="Nuovo profilo" Command="{Binding NewCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:CredentialProfile">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <StackPanel Grid.Column="1" Spacing="8">
      <TextBlock Text="Nome" /><TextBox Text="{Binding Name}" />
      <TextBlock Text="Utente" /><TextBox Text="{Binding Username}" />
      <TextBlock Text="Dominio" /><TextBox Text="{Binding Domain}" />
      <TextBlock Text="Password" /><TextBox Text="{Binding Password}" PasswordChar="●" Watermark="Vuota = non cambiare quella salvata" />
      <TextBlock Text="{Binding Error}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="Salva" Command="{Binding SaveCommand}" Classes="accent" />
        <Button Content="Elimina" Command="{Binding DeleteCommand}" />
        <Button Content="Chiudi" Click="OnClose" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
