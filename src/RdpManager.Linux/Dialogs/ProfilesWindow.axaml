<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RdpManager.Linux.ViewModels"
        xmlns:core="using:RdpManager.Core"
        x:Class="RdpManager.Linux.Dialogs.ProfilesWindow"
        x:DataType="vm:ProfilesViewModel"
        Title="Profili di credenziali" Width="700" Height="460" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <StyleInclude Source="avares://RdpManager.Linux/Dialogs/DialogStyles.axaml" />
  </Window.Styles>

  <!-- Windows apre un dialogo per ogni modifica (Nuovo…, Modifica…, Elimina); qui la modifica sta accanto all'elenco, con le stesse etichette e la stessa nota. -->
  <DockPanel Margin="16">
  <TextBlock DockPanel.Dock="Top" Classes="note" MaxWidth="640" Text="Un profilo tiene utente, dominio e password una volta sola: nella modifica di una connessione si sceglie in «Credenziali». Cambiando il profilo cambiano tutte le connessioni che lo usano." />
  <Grid ColumnDefinitions="240,*">
    <DockPanel Margin="0,0,20,0">
      <Button DockPanel.Dock="Bottom" Content="Nuovo" Command="{Binding NewCommand}" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
      <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:CredentialProfile">
            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="Elimina" Command="{Binding DeleteCommand}" Classes="danger" />
          <Button Content="Chiudi" Click="OnClose" MinWidth="88" />
          <Button Content="Salva" Command="{Binding SaveCommand}" Classes="accent" MinWidth="88" />
        </StackPanel>
      </StackPanel>

      <ScrollViewer>
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="110,*"><TextBlock Classes="rowLabel" Text="Nome" /><TextBox Grid.Column="1" Text="{Binding Name}" /></Grid>
          <Grid ColumnDefinitions="110,*"><TextBlock Classes="rowLabel" Text="Utente" /><TextBox Grid.Column="1" Text="{Binding Username}" /></Grid>
          <Grid ColumnDefinitions="110,*"><TextBlock Classes="rowLabel" Text="Dominio" /><TextBox Grid.Column="1" Text="{Binding Domain}" /></Grid>
          <Grid ColumnDefinitions="110,*"><TextBlock Classes="rowLabel" Text="Password" /><TextBox Grid.Column="1" Text="{Binding Password}" PasswordChar="●" Watermark="Vuota = non cambiare quella salvata" /></Grid>
          <Grid ColumnDefinitions="110,*"><TextBlock Grid.Column="1" Classes="note" MaxWidth="300" Margin="0" Text="Facoltativa. Viene salvata cifrata, solo per il tuo utente." /></Grid>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
  </DockPanel>
</Window>
