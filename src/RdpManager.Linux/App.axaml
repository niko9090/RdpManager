<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:RdpManager.Linux.Sessions"
             x:Class="RdpManager.Linux.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Gli stessi colori del programma Windows (src/RdpManager/UI/Theme.cs): chiaro = colori di sistema di Windows
             (Window, Control, ControlText, GrayText, ControlDark, Highlight), scuro = tavolozza di ThemeManager.Dark. -->
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AppAccent">#0078D7</Color>
          <Color x:Key="SystemAccentColor">#0078D7</Color>
          <SolidColorBrush x:Key="AppAccentBrush" Color="#0078D7" />
          <SolidColorBrush x:Key="AppHighlightTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppSidebarBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppBarBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#F0F0F0" />
          <SolidColorBrush x:Key="AppInputBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#000000" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="AppMutedBrush" Color="#6D6D6D" />
          <SolidColorBrush x:Key="AppDangerBrush" Color="#B22222" />
          <!-- Pulsanti, caselle di testo ed elenchi come i controlli di Windows Forms (stato normale, sopra, premuto). -->
          <SolidColorBrush x:Key="ButtonBackground" Color="#E1E1E1" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E5F1FB" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#CCE4F7" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#CCCCCC" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#ADADAD" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#0078D7" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#005499" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#000000" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#000000" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#000000" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#7A7A7A" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#171717" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0078D7" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#0078D7" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#0078D7" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#E5F3FF" />
          <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F0F0F0" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#A0A0A0" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#91C9F7" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#91C9F7" />
          <!-- Schede: linguetta scelta = colore delle caselle, le altre = colore dei controlli con testo grigio (Theme.DrawTabItem). -->
          <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected" Color="#F0F0F0" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#6D6D6D" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#000000" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#000000" />
          <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AppAccent">#2D5FA5</Color>
          <Color x:Key="SystemAccentColor">#2D5FA5</Color>
          <SolidColorBrush x:Key="AppAccentBrush" Color="#2D5FA5" />
          <SolidColorBrush x:Key="AppHighlightTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppSidebarBrush" Color="#202124" />
          <SolidColorBrush x:Key="AppBarBrush" Color="#2B2D31" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2B2D31" />
          <SolidColorBrush x:Key="AppInputBrush" Color="#34363B" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#E8E8EB" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="#464850" />
          <SolidColorBrush x:Key="AppMutedBrush" Color="#9698A0" />
          <SolidColorBrush x:Key="AppDangerBrush" Color="#F0786E" />
          <SolidColorBrush x:Key="ButtonBackground" Color="#34363B" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3E4147" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2D5FA5" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#2B2D31" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#464850" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#2D5FA5" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#2D5FA5" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#E8E8EB" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E8E8EB" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#34363B" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#34363B" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#34363B" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#E8E8EB" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#464850" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#9698A0" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2D5FA5" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#2D5FA5" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#2D5FA5" />
          <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#2B2D31" />
          <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2B2D31" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#464850" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#2D5FA5" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2D5FA5" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselected" Color="#2B2D31" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundUnselectedPointerOver" Color="#34363B" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundSelected" Color="#34363B" />
          <SolidColorBrush x:Key="TabItemHeaderBackgroundSelectedPointerOver" Color="#34363B" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#9698A0" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#E8E8EB" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#E8E8EB" />
          <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#E8E8EB" />
          <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Misure comuni, quelle di Windows Forms: controlli alti 24 px e carattere da 9 pt (12 px).
           Per il tocco la finestra principale prende la classe «touch» (più sotto) e tutto si ingrandisce. -->
      <x:Double x:Key="AppTouchSize">24</x:Double>
      <x:Double x:Key="AppFontSize">12</x:Double>
      <x:Double x:Key="AppSmallFontSize">12</x:Double>
      <x:Double x:Key="AppTitleFontSize">16</x:Double>
      <CornerRadius x:Key="AppRadius">2</CornerRadius>
      <Thickness x:Key="AppPagePadding">20</Thickness>

      <!-- Colori delle icone dell'albero, uguali nei due temi (MainForm.BuildImages di Windows). -->
      <SolidColorBrush x:Key="IconFolderFillBrush" Color="#F0C450" />
      <SolidColorBrush x:Key="IconFolderEdgeBrush" Color="#BE8C28" />
      <SolidColorBrush x:Key="IconStarBrush" Color="#F5B41E" />
      <SolidColorBrush x:Key="IconComputerBodyBrush" Color="#3C3C46" />
      <SolidColorBrush x:Key="IconStatusRingBackBrush" Color="#FFFFFF" />

      <!-- Icone vettoriali (niente dipendenza da font di simboli). -->
      <StreamGeometry x:Key="IconFolder">M2,5 L2,17 L18,17 L18,7 L9,7 L7,5 Z</StreamGeometry>
      <StreamGeometry x:Key="IconComputer">M2,3 L18,3 L18,13 L2,13 Z M7,15 L13,15 L13,17 L7,17 Z</StreamGeometry>
      <StreamGeometry x:Key="IconSearch">M8,2 A6,6 0 1 0 8,14 A6,6 0 1 0 8,2 Z M8,4 A4,4 0 1 1 8,12 A4,4 0 1 1 8,4 Z M12,12 L17,17 L15.6,18.4 L10.6,13.4 Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Tipografia e bersagli. -->
    <Style Selector="Window">
      <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="{StaticResource AppTouchSize}" />
      <Setter Property="MinWidth" Value="{StaticResource AppTouchSize}" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{StaticResource AppRadius}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="{StaticResource AppTouchSize}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{StaticResource AppRadius}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="{StaticResource AppTouchSize}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{StaticResource AppRadius}" />
    </Style>
    <Style Selector="AutoCompleteBox">
      <Setter Property="MinHeight" Value="{StaticResource AppTouchSize}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="{StaticResource AppTouchSize}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="{StaticResource AppTouchSize}" />
      <Setter Property="CornerRadius" Value="{StaticResource AppRadius}" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="{StaticResource AppTouchSize}" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="MinHeight" Value="{StaticResource AppTouchSize}" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
    </Style>

    <!-- Pulsante discreto per la barra comandi e per le schede. -->
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>

    <!-- Etichette e titoli nei moduli. -->
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.bar">
      <Setter Property="Background" Value="{DynamicResource AppBarBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Path.icon">
      <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.icon.muted">
      <Setter Property="Fill" Value="{DynamicResource AppMutedBrush}" />
    </Style>

    <!-- Aspetto da Windows Forms: colori, caratteri, schede, albero, menu (Styles/WindowsLook.axaml). -->
    <StyleInclude Source="avares://RdpManager.Linux/Styles/WindowsLook.axaml" />

    <!-- Modalità tocco (#47): la finestra principale prende la classe «touch» e righe, schede, menu e pulsanti si ingrandiscono. -->
    <Style Selector="Window.touch Button">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="MinWidth" Value="52" />
    </Style>
    <Style Selector="Window.touch TreeViewItem">
      <Setter Property="MinHeight" Value="52" />
    </Style>
    <Style Selector="Window.touch ListBoxItem">
      <Setter Property="MinHeight" Value="52" />
    </Style>
    <Style Selector="Window.touch TabItem">
      <Setter Property="MinHeight" Value="52" />
    </Style>
    <Style Selector="Window.touch MenuItem">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Window.touch TextBox">
      <Setter Property="MinHeight" Value="52" />
    </Style>
  </Application.Styles>

  <Application.DataTemplates>
    <!-- Scheda con una sessione FreeRDP. -->
    <DataTemplate DataType="s:FreeRdpSession">
      <s:FreeRdpSessionView />
    </DataTemplate>

    <!-- Contenuto della scheda segnaposto (finché non c'è l'host FreeRDP). -->
    <DataTemplate DataType="s:PlaceholderSessionContent" x:DataType="s:PlaceholderSessionContent">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="480" Margin="20">
        <Path Classes="icon" Data="{StaticResource IconComputer}" Width="48" Height="48" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Target}" HorizontalAlignment="Center" Classes="muted" />
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </Application.DataTemplates>
</Application>
