<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RdpManager.Linux.ViewModels"
        xmlns:l="using:RdpManager.Linux"
        xmlns:menus="using:RdpManager.Linux.Menus"
        xmlns:dlg="using:RdpManager.Linux.Dialogs"
        x:Class="RdpManager.Linux.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        dlg:WindowBehaviors.BackgroundWork="True"
        Title="RdpManager" Width="1100" Height="700" MinWidth="560" MinHeight="420">

  <!-- Scorciatoie del blocco A (le stesse del programma Windows). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+E" Command="{Binding EditCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
    <KeyBinding Gesture="Ctrl+H" Command="{Binding HistoryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding FavoriteCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding SettingsCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+Space" Command="{Binding QuickSearchCommand}" />
    <KeyBinding Gesture="Ctrl+Alt+L" Command="{Binding LockCommand}" />
  </Window.KeyBindings>

  <Grid>
  <!-- Schermata di blocco (#28): da bloccata si vede solo questa e le sessioni sono nascoste. -->
  <Border IsVisible="{Binding IsLocked}" Background="{DynamicResource AppSurfaceBrush}" ZIndex="10">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="360">
      <TextBlock Text="RdpManager è bloccato" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding LockHint}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="PIN" Margin="0,12,0,0" />
      <TextBox PasswordChar="●" Text="{Binding PinInput}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Classes="accent" Content="Sblocca" Command="{Binding UnlockCommand}" HorizontalAlignment="Left" />
      <TextBlock Classes="error" Text="{Binding LockError}" IsVisible="{Binding LockError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Button Classes="flat" Content="Ho dimenticato il PIN" Command="{Binding ForgotPinCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </Border>

  <DockPanel Background="{DynamicResource AppSurfaceBrush}" IsVisible="{Binding IsUnlocked}">
    <!-- Barra di stato -->
    <Border DockPanel.Dock="Bottom" Classes="bar" Padding="14,6" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" MinHeight="20"
                 FontSize="12" Classes="muted" VerticalAlignment="Center" />
    </Border>

    <!-- Barra di menu -->
    <menus:MainMenu DockPanel.Dock="Top" />

    <!-- Barra comandi -->
    <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,6">
          <Button Classes="accent" Content="Nuova connessione" Command="{Binding NewConnectionCommand}" />
          <Button Classes="flat" Content="Nuova cartella" Command="{Binding NewFolderCommand}" />
          <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource AppBorderBrush}" />
          <Button Classes="flat" Content="Modifica" Command="{Binding EditCommand}" />
          <Button Classes="flat" Content="Duplica" Command="{Binding DuplicateCommand}" />
          <Button Classes="flat" Content="Preferita" Command="{Binding FavoriteCommand}" ToolTip.Tip="Aggiungi o togli dalle preferite" />
          <Button Classes="flat danger" Content="Elimina" Command="{Binding DeleteCommand}" />
          <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource AppBorderBrush}" />
          <Button Classes="flat" Content="Profili" Command="{Binding ProfilesCommand}" ToolTip.Tip="Profili di credenziali" />
          <Button Classes="flat" Content="Impostazioni" Command="{Binding SettingsCommand}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid ColumnDefinitions="300,Auto,*">
      <!-- Barra laterale: ricerca e albero delle connessioni -->
      <Border Grid.Column="0" MinWidth="200" Background="{DynamicResource AppSidebarBrush}">
        <DockPanel Margin="10">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBox Name="SearchBox" Text="{Binding SearchText}" Watermark="Cerca connessioni…">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="flat" Content="✕" Margin="4,0,0,0"
                    Command="{Binding ClearSearchCommand}" ToolTip.Tip="Cancella la ricerca" />
          </Grid>

          <Grid>
            <TreeView Name="ConnectionTree" Background="Transparent" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}"
                      dlg:WindowBehaviors.MultiSelect="True" dlg:WindowBehaviors.DragDrop="True">
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Connetti" Command="{Binding ConnectCommand}" />
                  <MenuItem Header="Connetti tutta la cartella" Command="{Binding ConnectFolderCommand}" />
                  <MenuItem Header="Modifica…" Command="{Binding EditCommand}" />
                  <MenuItem Header="Duplica" Command="{Binding DuplicateCommand}" />
                  <MenuItem Header="Preferita" Command="{Binding FavoriteCommand}" />
                  <Separator />
                  <MenuItem Header="Sposta in una cartella…" Command="{Binding MoveToFolderCommand}" />
                  <MenuItem Header="Assegna un profilo di credenziali…" Command="{Binding AssignProfileCommand}" />
                  <MenuItem Header="Impostazioni della cartella…" Command="{Binding FolderSettingsCommand}" />
                  <MenuItem Header="Esporta come file .rdp…" Command="{Binding ExportRdpFileCommand}" />
                  <MenuItem Header="Accendi (Wake-on-LAN)" Command="{Binding WakeCommand}" />
                  <MenuItem Header="Verifica raggiungibilità" Command="{Binding CheckReachabilityCommand}" />
                  <Separator />
                  <MenuItem Header="Elimina" Command="{Binding DeleteCommand}" />
                </ContextMenu>
              </TreeView.ContextMenu>
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4" ToolTip.Tip="{Binding StatusText}">
                    <Path Classes="icon" Margin="0,0,10,0"
                          Data="{StaticResource IconFolder}" IsVisible="{Binding IsFolder}" />
                    <Path Classes="icon" Margin="0,0,10,0"
                          Data="{StaticResource IconComputer}" IsVisible="{Binding !IsFolder}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                 FontWeight="{Binding IsFolder, Converter={x:Static l:Converters.FolderWeight}}" />
                      <TextBlock Text="{Binding Subtitle}" FontSize="12" Classes="muted"
                                 TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsFolder}" />
                    </StackPanel>
                    <!-- Colore dell'etichetta e stato di raggiungibilità (#4, #13) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !IsFolder}">
                      <Border Width="10" Height="10" CornerRadius="2" IsVisible="{Binding HasLabelColor}"
                              Background="{Binding LabelColor, Converter={x:Static dlg:HexBrushConverter.Instance}}" />
                      <Ellipse Width="10" Height="10"
                               Fill="{Binding StatusColor, Converter={x:Static dlg:HexBrushConverter.Instance}}" />
                    </StackPanel>
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <TextBlock Text="Nessuna connessione trovata." IsVisible="{Binding NoResults}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource AppBorderBrush}" ResizeDirection="Columns" />

      <!-- Area a schede per le sessioni -->
      <Grid Grid.Column="2">
        <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" IsVisible="{Binding HasTabs}" Padding="0">
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionTabViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon" Data="{StaticResource IconComputer}" Width="16" Height="16" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                <Button Classes="flat" Content="✕" MinWidth="32" MinHeight="32" Padding="0"
                        Command="{Binding CloseCommand}" ToolTip.Tip="Chiudi la scheda" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:SessionTabViewModel">
              <ContentControl Content="{Binding Content}" />
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>

        <!-- Stato vuoto -->
        <StackPanel IsVisible="{Binding !HasTabs}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="10" MaxWidth="440" Margin="24">
          <Path Classes="icon muted" Data="{StaticResource IconComputer}" Width="64" Height="64" HorizontalAlignment="Center" />
          <TextBlock Text="Nessuna sessione aperta" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Fai doppio clic su una connessione per aprirla in una scheda, oppure creane una nuova."
                     TextWrapping="Wrap" TextAlignment="Center" Classes="muted" />
          <Button Classes="accent" Content="Nuova connessione" Command="{Binding NewConnectionCommand}"
                  HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>
    </Grid>
  </DockPanel>
  </Grid>
</Window>
