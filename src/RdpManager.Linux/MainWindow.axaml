<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RdpManager.Linux.ViewModels"
        xmlns:l="using:RdpManager.Linux"
        xmlns:menus="using:RdpManager.Linux.Menus"
        xmlns:sessions="using:RdpManager.Linux.Sessions"
        xmlns:dlg="using:RdpManager.Linux.Dialogs"
        x:Class="RdpManager.Linux.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        dlg:WindowBehaviors.BackgroundWork="True"
        Title="{Binding WindowTitle}" Icon="avares://RdpManager.Linux/Assets/app.png"
        Width="1400" Height="900" MinWidth="800" MinHeight="500">

  <!-- Scorciatoie fisse del blocco A. Ctrl+Alt+Spazio e Ctrl+Alt+L stanno nella ShortcutMap configurabile (blocco B). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewFolderCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportRdpCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding EditCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateCommand}" />
    <KeyBinding Gesture="Ctrl+H" Command="{Binding HistoryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding FavoriteCommand}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding SettingsCommand}" />
  </Window.KeyBindings>

  <Grid>
  <!-- Schermata di blocco (#28): da bloccata si vede solo questa e le sessioni sono nascoste. -->
  <Border IsVisible="{Binding IsLocked}" Background="{DynamicResource AppSurfaceBrush}" ZIndex="10">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Width="360">
      <TextBlock Text="RdpManager è bloccato" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding LockHint}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="PIN" Margin="0,12,0,0" />
      <TextBox PasswordChar="●" Text="{Binding PinInput}">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Classes="accent" Content="Sblocca" Command="{Binding UnlockCommand}" HorizontalAlignment="Left" />
      <TextBlock Classes="error" Text="{Binding LockError}" IsVisible="{Binding LockError, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Button Classes="flat" Content="Ho dimenticato il PIN" Command="{Binding ForgotPinCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </Border>

  <DockPanel Background="{DynamicResource AppSurfaceBrush}" IsVisible="{Binding IsUnlocked}">
    <!-- Barra di stato -->
    <!-- Barra di stato (StatusStrip): a sinistra il riepilogo, poi l'ultimo avviso. -->
    <Border DockPanel.Dock="Bottom" Classes="bar" Padding="8,3" BorderThickness="0" IsVisible="{Binding ChromeVisible}">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="{Binding StatusSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Barra di menu (come Windows: nessuna barra comandi in alto; i comandi rapidi stanno sopra l'elenco). -->
    <menus:MainMenu DockPanel.Dock="Top" IsVisible="{Binding ChromeVisible}" />

    <Grid x:Name="MainGrid" ColumnDefinitions="280,Auto,*">
      <!-- Barra laterale: ricerca e albero delle connessioni (fissa, oppure a comparsa dal bordo sinistro) -->
      <Border x:Name="SidebarPanel" Grid.Column="0" MinWidth="180" Background="{DynamicResource AppSidebarBrush}">
        <DockPanel>
          <!-- Intestazione (come ToolStrip di Windows): titolo in grassetto, a destra «Cerca PC» e fissa/a comparsa. -->
          <Border DockPanel.Dock="Top" Classes="bar" Padding="4,1">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Classes="sidebarTitle" Text="Connessioni" Margin="4,0,0,0" />
              <Button Grid.Column="1" Classes="flat" Content="Cerca PC" MinHeight="22" Padding="6,0"
                      Command="{Binding NetworkScanCommand}"
                      ToolTip.Tip="Cerca PC in rete (rete locale, Tailscale, altre VPN)" />
              <Button Grid.Column="2" Classes="flat" Content="{Binding PinButtonText}" MinHeight="22" Padding="6,0"
                      Command="{Binding PinSidebarCommand}" ToolTip.Tip="{Binding PinButtonTip}" />
            </Grid>
          </Border>
          <TextBox DockPanel.Dock="Top" Name="SearchBox" Text="{Binding SearchText}" Watermark="Cerca (Ctrl+F)…" Margin="0,2,0,0">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <!-- Comandi rapidi: a capo invece di un menu di comandi nascosti (come Windows). -->
          <Border DockPanel.Dock="Top" Classes="bar" Padding="2,1">
            <WrapPanel>
              <Button Classes="flat" Content="Nuova" MinHeight="22" Padding="6,0" Command="{Binding NewConnectionCommand}" ToolTip.Tip="Nuova connessione (Ctrl+N)" />
              <Button Classes="flat" Content="Cartella" MinHeight="22" Padding="6,0" Command="{Binding NewFolderCommand}" ToolTip.Tip="Nuova cartella (Ctrl+Shift+N)" />
              <Button Classes="flat" Content="Modifica" MinHeight="22" Padding="6,0" Command="{Binding EditCommand}" ToolTip.Tip="Modifica (Ctrl+E)" />
              <Button Classes="flat" Content="Duplica" MinHeight="22" Padding="6,0" Command="{Binding DuplicateCommand}" ToolTip.Tip="Duplica (Ctrl+D)" />
              <Button Classes="flat" Content="Elimina" MinHeight="22" Padding="6,0" Command="{Binding DeleteCommand}" ToolTip.Tip="Elimina (Canc)" />
            </WrapPanel>
          </Border>

          <Grid>
            <TreeView Name="ConnectionTree" Background="Transparent" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}"
                      dlg:WindowBehaviors.MultiSelect="True" dlg:WindowBehaviors.DragDrop="True">
              <TreeView.ContextMenu>
                <ContextMenu>
                  <!-- Stesso ordine e stessi testi del menu dell'elenco di Windows; le voci di cartella si vedono solo su una cartella. -->
                  <MenuItem Header="Connetti" Command="{Binding ConnectCommand}" />
                  <MenuItem Header="Connetti tutta la cartella" Command="{Binding ConnectFolderCommand}"
                            IsVisible="{Binding SelectedNode.IsFolder, FallbackValue=False}" />
                  <MenuItem Header="Impostazioni della cartella…" Command="{Binding FolderSettingsCommand}"
                            IsVisible="{Binding SelectedNode.IsFolder, FallbackValue=False}" />
                  <MenuItem Header="Esporta come file .rdp…" Command="{Binding ExportRdpFileCommand}" />
                  <MenuItem Header="Accendi (Wake-on-LAN)" Command="{Binding WakeCommand}" />
                  <MenuItem Header="Verifica raggiungibilità" Command="{Binding CheckReachabilityCommand}" />
                  <Separator />
                  <MenuItem Header="Preferita ★" Command="{Binding FavoriteCommand}" />
                  <MenuItem Header="Cronologia…" Command="{Binding HistoryCommand}" />
                  <Separator />
                  <MenuItem Header="Nuova connessione…" Command="{Binding NewConnectionCommand}" />
                  <MenuItem Header="Nuova cartella…" Command="{Binding NewFolderCommand}" />
                  <MenuItem Header="Modifica / Rinomina…" Command="{Binding EditCommand}" />
                  <MenuItem Header="Duplica" Command="{Binding DuplicateCommand}" />
                  <MenuItem Header="Sposta in una cartella…" Command="{Binding MoveToFolderCommand}" />
                  <MenuItem Header="Assegna un profilo di credenziali…" Command="{Binding AssignProfileCommand}" />
                  <MenuItem Header="Elimina" Command="{Binding DeleteCommand}" />
                </ContextMenu>
              </TreeView.ContextMenu>
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                  <!-- Una riga come in Windows: icona da 16 px (cartella gialla, stella, PC con lo schermo del colore
                       dell'etichetta e il pallino di raggiungibilità) e il nome; indirizzo e stato nel suggerimento. -->
                  <Grid ColumnDefinitions="Auto,*" Margin="0,1" ToolTip.Tip="{Binding ToolTipText}">
                    <Panel Width="16" Height="16" Margin="0,0,5,0" VerticalAlignment="Center">
                      <Canvas IsVisible="{Binding IsFolder}" Width="16" Height="16">
                        <Rectangle Canvas.Left="1" Canvas.Top="4" Width="14" Height="10" Fill="{DynamicResource IconFolderFillBrush}" />
                        <Rectangle Canvas.Left="1" Canvas.Top="2" Width="6" Height="3" Fill="{DynamicResource IconFolderFillBrush}" />
                        <Rectangle Canvas.Left="1.5" Canvas.Top="4.5" Width="13" Height="9" Stroke="{DynamicResource IconFolderEdgeBrush}" StrokeThickness="1" />
                      </Canvas>
                      <Canvas IsVisible="{Binding IsSection}" Width="16" Height="16">
                        <Path Fill="{DynamicResource IconStarBrush}" Data="M8,1 L9.88,5.91 L15.13,6.18 L11.04,9.49 L12.41,14.57 L8,11.7 L3.59,14.57 L4.96,9.49 L0.87,6.18 L6.12,5.91 Z" />
                      </Canvas>
                      <Canvas IsVisible="{Binding IsConnection}" Width="16" Height="16">
                        <Rectangle Canvas.Left="1" Canvas.Top="2" Width="14" Height="10" Fill="{DynamicResource IconComputerBodyBrush}" />
                        <Rectangle Canvas.Left="2" Canvas.Top="3" Width="12" Height="8"
                                   Fill="{Binding ScreenColor, Converter={x:Static dlg:HexBrushConverter.Instance}}" />
                        <Rectangle Canvas.Left="6" Canvas.Top="12" Width="4" Height="2" Fill="{DynamicResource IconComputerBodyBrush}" />
                        <Rectangle Canvas.Left="4" Canvas.Top="14" Width="8" Height="1" Fill="{DynamicResource IconComputerBodyBrush}" />
                        <Ellipse Canvas.Left="8.5" Canvas.Top="8.5" Width="7.5" Height="7.5" Fill="{DynamicResource IconStatusRingBackBrush}" IsVisible="{Binding HasStatusColor}" />
                        <Ellipse Canvas.Left="10.2" Canvas.Top="10.2" Width="4.2" Height="4.2" StrokeThickness="2" IsVisible="{Binding HasStatusColor}"
                                 Stroke="{Binding StatusColor, Converter={x:Static dlg:HexBrushConverter.Instance}}" />
                      </Canvas>
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               FontWeight="{Binding IsSection, Converter={x:Static l:Converters.SectionWeight}}" />
                  </Grid>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
            <TextBlock Text="Nessuna connessione trovata." IsVisible="{Binding NoResults}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" />
          </Grid>
        </DockPanel>
      </Border>

      <!-- Bordo sensibile: con la barra a comparsa, avvicinando il mouse la barra si apre. -->
      <Border x:Name="SidebarEdge" Grid.Column="0" Width="6" HorizontalAlignment="Left" Background="Transparent" IsVisible="False" ZIndex="5" />

      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" Background="{DynamicResource AppSurfaceBrush}" ResizeDirection="Columns" />

      <!-- Area a schede per le sessioni: la riga delle schede qui, le viste delle sessioni in SessionHost -->
      <Grid Grid.Column="2">
        <DockPanel IsVisible="{Binding HasTabs}">
        <TabControl x:Name="TabStrip" DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0">
          <TabControl.ContextMenu>
            <ContextMenu>
              <!-- Stesse voci e stessi testi del menu delle schede di Windows («Apri con mstsc» esiste solo lì). -->
              <MenuItem Header="Riconnetti" Command="{Binding ReconnectCommand}" InputGesture="F5" />
              <MenuItem Header="Schermo intero" Command="{Binding FullScreenCommand}" InputGesture="F11" />
              <MenuItem Header="Stacca in una finestra" Command="{Binding DetachTabCommand}" InputGesture="Ctrl+Shift+D" />
              <MenuItem Header="Vista affiancata" Command="{Binding SplitViewCommand}" />
              <Separator />
              <MenuItem Header="Chiudi scheda" Command="{Binding CloseCurrentTabCommand}" InputGesture="Ctrl+F4" />
            </ContextMenu>
          </TabControl.ContextMenu>
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionTabViewModel">
              <!-- Come in Windows: pallino di stato (12 px) e titolo; la X solo con la modalità tocco. -->
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                         Fill="{Binding StateColor, Converter={x:Static dlg:HexBrushConverter.Instance}}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                <Button Classes="flat tabclose" Content="✕" MinWidth="32" MinHeight="32" Padding="0"
                        Command="{Binding CloseCommand}" ToolTip.Tip="Chiudi la scheda" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:SessionTabViewModel">
              <Panel />
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
        <sessions:SessionHostPanel x:Name="SessionHost" />
        </DockPanel>

        <!-- Stato vuoto -->
        <!-- Stato vuoto: solo testo grigio al centro, con le scorciatoie in uso (come la Label di Windows). -->
        <TextBlock IsVisible="{Binding !HasTabs}" Text="{Binding EmptyHint}" Classes="muted"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24" />
      </Grid>
    </Grid>
  </DockPanel>
  </Grid>
</Window>
