<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RdpManager</RootNamespace>
    <AssemblyName>RdpManager</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <Product>RdpManager</Product>
    <!-- Versione dell'app: cambiarla qui prima di creare il tag vX.Y.Z (vedi README, «Aggiornamenti»). -->
    <Version>1.5.1</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <!-- Versione del prodotto pulita ("1.3.0"), senza l'hash del commit aggiunto dall'SDK. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Metadati dell'exe (Dettagli nelle proprietà del file): servono anche agli antivirus per riconoscerlo. -->
    <Company>niko9090</Company>
    <Copyright>Copyright © 2026 niko9090 - https://github.com/niko9090/RdpManager</Copyright>
    <AssemblyTitle>RdpManager - gestore di desktop remoti a schede</AssemblyTitle>
    <Description>Gestore di connessioni Desktop remoto (RDP) con sessioni in schede</Description>
    <NeutralLanguage>it-IT</NeutralLanguage>
    <RepositoryUrl>https://github.com/niko9090/RdpManager</RepositoryUrl>
    <!-- Avvio con i diritti dell'utente (asInvoker), dichiarato per Windows 10/11. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Pubblicazione a cartella (dotnet publish -r win-x64 con self-contained): è quella che va nell'installer.
      L'exe portatile a file unico si chiede esplicitamente con -p:PublishSingleFile=true (vedi build-installer.ps1);
      mai compresso (EnableCompressionInSingleFile resta spento).
    -->
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RdpManager.Tests" />
  </ItemGroup>

</Project>
