<Project>
  <!-- Prima il Directory.Build.props della radice (Source Link spento). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Versione del programma: UNICO punto (bump qui prima del tag vX.Y.Z; lo fa scripts/release.ps1).
    La usano RdpManager, RdpManager.Linux, RdpManager.Core e i progetti Platform.*: AppInfo.Version legge la
    versione dell'assembly del Core, quindi deve coincidere con quella del programma (era 1.0.0 senza questa).
    RdpManagerVpn (src/RdpManagerVpn) e server/rdpm-sync hanno la propria <Version> nel csproj, che ha la precedenza.
  -->
  <PropertyGroup>
    <Version>1.12.1</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <!-- Versione del prodotto pulita ("1.3.0"), senza l'hash del commit aggiunto dall'SDK. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
